---
import Layout from '@/layouts/Layout.astro';
import { site, pageTitle } from '@/lib/settings';
import { buttonVariants } from '@/components/ui/button';
const page = site.pages.notFound;
---
<Layout title={pageTitle(page.title)} description={page.description} noindex>
  <div class="flex flex-col items-center justify-center py-24 text-center">
    <span class="font-mono text-sm text-muted-foreground">{page.code}</span>
    <h1 class="mt-3 type-title">{page.title}</h1>
    <p class="mt-3 max-w-sm text-sm leading-relaxed text-muted-foreground">{page.description}</p>
    <a href={page.action.href} class={buttonVariants({ className: 'mt-6' })}>{page.action.label}</a>
  </div>
</Layout>
