---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { getCourses } from '@/lib/content';
import { site, ui, text, pageTitle } from '@/lib/settings';
import { render } from 'astro:content';
const courses = await getCourses();
const page = site.pages.teaching;
---
<Layout title={pageTitle(page.title)} description={page.description}>
  <div>
    <PageHeader {...page} />
    <section aria-labelledby="courses-title" class="border-t pt-8 sm:pt-10" data-viewport-reveal>
      <div class="mb-6 flex items-baseline justify-between gap-4">
        <h2 id="courses-title" class="type-section">{page.sectionTitle}</h2>
        <span class="type-label tabular-nums">{String(courses.length).padStart(2, '0')}</span>
      </div>
      <ol role="list" class="list-none space-y-3">
        {courses.map(async (course, index) => {
          const { Content } = await render(course);
          return <li class="flex items-start gap-5 rounded-lg bg-background p-5 text-foreground sm:gap-6 sm:p-6">
            <span aria-hidden="true" class="type-label shrink-0 pt-0.5 tabular-nums">{String(index + 1).padStart(2, '0')}</span>
            <div class="min-w-0 flex-1">
              <h3 class="type-item">{course.data.title}</h3>
              {course.body?.trim() && <div class="content-prose mt-3"><Content /></div>}
              {course.data.url && <a href={course.data.url} target="_blank" rel="noopener noreferrer" aria-label={text(ui.courseWebsiteLabel, { title: course.data.title })} class="mt-1 inline-flex min-h-11 items-center gap-1.5 text-[13px] underline decoration-border underline-offset-4 hover:decoration-foreground">{ui.courseWebsite}<span aria-hidden="true">↗</span></a>}
            </div>
          </li>;
        })}
      </ol>
    </section>
  </div>
</Layout>
