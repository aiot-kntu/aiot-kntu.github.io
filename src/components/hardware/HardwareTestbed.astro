---
import './hardware.css';

import hardware from '@/content/settings/hardware.json';
import { text } from '@/lib/settings';
import { buttonVariants } from '@/components/ui/button';

const { devices } = hardware;
const selected = devices.find(device => device.id === hardware.defaultDevice) ?? devices[0];
---

<iot-testbed id="hardware" class="hardware-testbed block">
  <figure class="m-0" aria-label={hardware.figureLabel}>
    <div class="overflow-hidden rounded-xl border border-border bg-card">
      <div class="flex items-center justify-between gap-3 px-5 py-4 font-mono text-xs tracking-wide text-muted-foreground">
        <span>{hardware.figureNumber} <span class="mx-1 opacity-40">/</span> {hardware.figureTitle}</span>
        <span class="flex items-center gap-1.5"><span class="hardware-status-dot"></span>{hardware.status}</span>
      </div>

      <!-- Photo plate: one light surface in both themes, so the white product
           shots blend into it instead of showing as white boxes. -->
      <div class="hardware-plate mx-3 rounded-lg">
        {devices.map(device => (
          <img
            src={device.photo}
            alt={text(hardware.photoAlt, { name: device.name })}
            width={device.photoWidth}
            height={device.photoHeight}
            loading="lazy"
            decoding="async"
            data-photo={device.id}
            data-active={device.id === selected?.id ? '' : undefined}
            aria-hidden={device.id === selected?.id ? undefined : 'true'}
            class="hardware-photo-img"
          />
        ))}
        <span class="hardware-plate-label font-mono" data-selection>{selected && `${selected.number} / ${selected.name}`}</span>
      </div>

      <div class="hardware-choices mt-3 grid grid-cols-3 gap-2 border-t border-border p-3" role="group" aria-label={hardware.selectionLabel}>
        <span class="hardware-blob" aria-hidden="true"></span>
        {devices.map(device => (
          <button type="button" data-select={device.id} aria-pressed={device.id === selected?.id} class={buttonVariants({ variant: 'ghost', size: 'sm', className: 'hardware-choice h-auto min-w-0 flex-col gap-1.5 px-1.5 py-2 text-center hover:bg-transparent sm:flex-row sm:gap-2.5 sm:py-1.5 sm:pl-1.5 sm:pr-3 sm:text-left' })}>
            <span class="hardware-thumb" aria-hidden="true">
              <img src={device.photo} alt="" width={device.photoWidth} height={device.photoHeight} loading="lazy" decoding="async" />
            </span>
            <span class="flex min-w-0 max-w-full flex-col">
              <span class="hardware-choice-number block font-mono text-[11px] leading-4">{device.number}</span>
              <span class="hardware-choice-name block truncate text-xs font-medium leading-4 sm:text-[13px]">{device.name}</span>
            </span>
          </button>
        ))}
      </div>
    </div>

    <figcaption class="pt-4">
      {devices.map(device => (
        <div data-panel={device.id} hidden={device.id !== selected?.id} class="hardware-details">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <p class="text-[13px] font-medium text-foreground">{device.role}</p>
            <span class="font-mono text-xs text-muted-foreground">{device.spec}</span>
          </div>
          <p class="mt-2 max-w-[60ch] text-[15px] leading-relaxed text-muted-foreground">{device.description}</p>
        </div>
      ))}
    </figcaption>
  </figure>
</iot-testbed>

<script>
  import hardware from '@/content/settings/hardware.json';

  class IotTestbed extends HTMLElement {
    private dispose?: () => void;

    connectedCallback() {
      const controls = [...this.querySelectorAll<HTMLButtonElement>('[data-select]')];
      const photos = [...this.querySelectorAll<HTMLImageElement>('[data-photo]')];
      const panels = [...this.querySelectorAll<HTMLElement>('[data-panel]')];
      const abort = new AbortController();
      const { signal } = abort;
      const names: Record<string, string> = Object.fromEntries(hardware.devices.map(device => [device.id, `${device.number} / ${device.name}`]));

      // The other boards load right away so switching never waits on the network.
      photos.forEach(photo => { photo.loading = 'eager'; });

      const blob = this.querySelector<HTMLSpanElement>('.hardware-blob');
      const container = this.querySelector<HTMLElement>('.hardware-choices');
      let currentDevice: string = hardware.defaultDevice || hardware.devices[0]?.id;
      let hoveredTarget: HTMLElement | null = null;
      let initialized = false;

      const positionBlob = (target: HTMLElement | null, immediate = false) => {
        if (!blob || !container || !target) return;
        const cr = container.getBoundingClientRect();
        const tr = target.getBoundingClientRect();
        if (tr.width === 0 && tr.height === 0) return;

        if (immediate || !initialized) {
          blob.style.transition = 'none';
        }
        const x = tr.left - cr.left + container.scrollLeft;
        const y = tr.top - cr.top + container.scrollTop;
        blob.style.transform = `translate3d(${x}px, ${y}px, 0)`;
        blob.style.width = `${tr.width}px`;
        blob.style.height = `${tr.height}px`;
        blob.style.opacity = '1';

        if (immediate || !initialized) {
          blob.offsetHeight;
          blob.style.transition = '';
          if (!immediate) initialized = true;
        }
      };

      const getSelectedButton = () => controls.find(c => c.dataset.select === currentDevice) ?? null;
      const syncBlobToSelected = (immediate = false) => positionBlob(getSelectedButton(), immediate);

      const select = (device: string) => {
        if (!(device in names)) return;
        currentDevice = device;
        for (const photo of photos) {
          const active = photo.dataset.photo === device;
          photo.toggleAttribute('data-active', active);
          if (active) photo.removeAttribute('aria-hidden');
          else photo.setAttribute('aria-hidden', 'true');
        }
        for (const control of controls) control.setAttribute('aria-pressed', String(control.dataset.select === device));
        for (const panel of panels) panel.hidden = panel.dataset.panel !== device;
        this.querySelector('[data-selection]')!.textContent = names[device];
        syncBlobToSelected();
      };

      container?.addEventListener('pointermove', event => {
        const target = (event.target as Element).closest<HTMLButtonElement>('[data-select]');
        if (target && target !== hoveredTarget) {
          hoveredTarget = target;
          positionBlob(target);
        }
      }, { signal });

      container?.addEventListener('pointerleave', () => {
        hoveredTarget = null;
        syncBlobToSelected();
      }, { signal });

      this.addEventListener('click', event => {
        const device = (event.target as Element).closest<HTMLElement>('[data-select]')?.dataset.select;
        if (device) select(device);
      }, { signal });
      this.addEventListener('keydown', event => {
        const index = controls.indexOf(event.target as HTMLButtonElement);
        if (index < 0) return;
        let next = index;
        if (event.key === 'ArrowRight') next = (index + 1) % controls.length;
        else if (event.key === 'ArrowLeft') next = (index + controls.length - 1) % controls.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = controls.length - 1;
        else return;
        event.preventDefault(); controls[next].focus(); select(controls[next].dataset.select!);
      }, { signal });
      const ro = new ResizeObserver(() => {
        positionBlob(hoveredTarget || getSelectedButton(), true);
      });
      if (container) ro.observe(container);
      const initialDevice = hardware.devices.find(device => device.id === hardware.defaultDevice) ?? hardware.devices[0];
      if (initialDevice) select(initialDevice.id);
      this.dispose = () => { abort.abort(); ro.disconnect(); };
    }

    disconnectedCallback() { this.dispose?.(); }
  }

  if (!customElements.get('iot-testbed')) customElements.define('iot-testbed', IotTestbed);
</script>
